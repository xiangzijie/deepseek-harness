{
  "name": "@deepseek-ai/dsh-bug-platform-autofix",
  "description": "Menu mapping, ticket selection, and orchestration for internal bug-platform autofix (library-first)",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bug-platform/bug-platform-autofix"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./personal-skill-plugin": {
      "types": "./lib/types/personal-skill-plugin.d.ts",
      "default": "./lib/types/personal-skill-plugin.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/dsh-bug-platform-http": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-bug-platform-http": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
